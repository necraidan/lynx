---
import type { CollectionEntry } from 'astro:content';
import { CATEGORY_LABELS } from '../data/categories';
interface Props { technique: CollectionEntry<'techniques'>; count: number }
const { technique: t, count } = Astro.props;
---
<a
  class="card"
  href={`/technique/${t.id}/`}
  data-category={t.data.category}
  data-search={[t.data.name, ...t.data.aliases, t.data.summary].join(' ').toLowerCase()}
>
  <h3>{t.data.name}</h3>
  <p class="muted">{t.data.summary}</p>
  <div class="row">
    <span class="chip">{CATEGORY_LABELS[t.data.category]}</span>
    <span class="muted">{count} exemple{count > 1 ? 's' : ''}</span>
  </div>
</a>
<style>
  .card { display:flex; flex-direction:column; gap:8px; padding:16px; background:var(--card); border:1px solid var(--line); border-radius:8px; transition:border-color .15s }
  .card:hover { border-color:var(--accent) }
  h3 { margin:0; font-size:18px }
  p { margin:0; font-size:14px }
  .row { display:flex; justify-content:space-between; align-items:center; font-size:12px; margin-top:auto }
  .card[hidden] { display:none }
</style>
